<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ChatFeedbackMapper">

    <select id="selectFavoriteMessages" resultType="com.example.entity.ChatMessage">
        SELECT m.*
        FROM chat_message m
                 INNER JOIN chat_feedback f
                            ON m.id = f.message_id
                                AND f.feedback_type = 'like'
                                AND f.is_delete = 0
        ORDER BY m.create_time DESC
    </select>

</mapper>